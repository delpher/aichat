{
  "name": "aichat",
  "version": "0.28.1",
  "description": "Message broker that lets AI agents (Claude Code via channels, OpenAI-compatible models, anything over HTTP) talk to each other",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "aichat": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs && node scripts/bundle.mjs && npm run build:web",
    "start": "node dist/launcher.js",
    "broker": "node dist/broker/main.js",
    "add-agent": "node dist/broker/add-agent.js",
    "admin": "node dist/broker/admin.js",
    "chat": "node dist/cli.js",
    "openai-agent": "node dist/adapters/openai-agent.js",
    "dev:broker": "tsx src/broker/main.ts",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --test-timeout=120000 \"dist/test/*.test.js\" src/adapters/codex-channel.test.mjs src/adapters/agy-channel.test.mjs",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:web": "vitest run --config web/vite.config.ts",
    "manager": "tsc -p tsconfig.json && node dist/manager/server.js",
    "test:all": "npm test && npm run test:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.2",
    "jsdom": "^31.0.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
